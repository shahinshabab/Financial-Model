# Copy to .streamlit/secrets.toml (git-ignored) and fill in. Environment variables with
# the same names also work.

# Supabase: Dashboard > Project Settings > API
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
# Option A (single user, simplest): service_role key + your user's UUID (Authentication > Users).
#   Keep the service_role key private; never expose it in a public deployment.
# Option B (multi-user / RLS): anon key and leave SUPABASE_USER_ID empty; the app shows an email/password sign-in.
SUPABASE_KEY = "YOUR-SUPABASE-KEY"
SUPABASE_USER_ID = "YOUR-USER-UUID"

# OpenAI (enables the "Generate" buttons)
OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-4o-mini"
